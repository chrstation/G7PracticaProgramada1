@model List<ClienteViewModel>
@{
    ViewData["Title"] = "Clientes";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Listado de clientes</h1>
    <a class="btn btn-primary" asp-action="Create">Registrar cliente</a>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info">No hay clientes registrados.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>Cédula</th>
                    <th>Nombre</th>
                    <th>Correo</th>
                    <th>Teléfonos</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var cliente in Model)
                {
                    <tr>
                        <td>@cliente.Cedula</td>
                        <td>@cliente.NombreCompleto</td>
                        <td>@cliente.Correo</td>
                        <td>@cliente.TelefonosTexto</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@cliente.Id">Detalle</a>
                            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@cliente.Id">Editar</a>
                            <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@cliente.Id">Borrar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
