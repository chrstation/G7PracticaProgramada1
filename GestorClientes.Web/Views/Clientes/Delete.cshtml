@model ClienteViewModel
@{
    ViewData["Title"] = "Borrar cliente";
}

<h1 class="h3 mb-3">Borrar cliente</h1>

<div class="alert alert-warning">
    ¿Está seguro de que desea borrar este cliente? También se borrarán sus teléfonos. Esta acción no se puede deshacer.
</div>

<dl class="row">
    <dt class="col-sm-3">Cédula</dt>
    <dd class="col-sm-9">@Model.Cedula</dd>

    <dt class="col-sm-3">Nombre</dt>
    <dd class="col-sm-9">@Model.NombreCompleto</dd>

    <dt class="col-sm-3">Correo electrónico</dt>
    <dd class="col-sm-9">@Model.Correo</dd>

    <dt class="col-sm-3">Teléfonos</dt>
    <dd class="col-sm-9">@Model.TelefonosTexto</dd>
</dl>

<form asp-action="Delete" method="post">
    <input type="hidden" name="id" value="@Model.Id" />
    <button type="submit" class="btn btn-danger">Sí, borrar</button>
    <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
</form>
